{
  "buildCommand": "vite build",
  "rewrites": [
    {"source": "/s/:id", "destination": "/api/share-page?id=:id"},
    {"source": "/_nova/static/:path(.*)", "destination": "https://us-assets.i.posthog.com/static/:path"},
    {"source": "/_nova/array/:path(.*)", "destination": "https://us-assets.i.posthog.com/array/:path"},
    {"source": "/_nova/:path(.*)", "destination": "https://us.i.posthog.com/:path"},
    {"source": "/(.*)", "destination": "/index.html"}
  ],
  "crons": [
    {"path": "/api/cleanup", "schedule": "0 0 * * *"},
    {"path": "/api/daily-suggestions-generate", "schedule": "0 13 * * *"},
    {"path": "/api/daily-suggestions-repair", "schedule": "0 16 * * *"}
  ]
}
