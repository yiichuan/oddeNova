# ============================================================
# oddeNova Environment Variables
# ============================================================
#
# NOTE: API keys can also be configured in the app UI (ApiKeyModal).
# These env vars are OPTIONAL overrides for development and CI scripts.
#
# For eval scripts (scripts/eval/), see scripts/eval/.env.example instead.

# Supabase project URL and anon key — exposed to the browser by Vite.
# Required for account registration/login and Supabase Auth session handling.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# LLM API key — overrides the key stored via the in-app UI
# Anthropic key format: sk-ant-xxxxx
# DeepSeek key format:  sk-xxxxx
VITE_API_KEY=

# LLM API base URL — overrides the built-in provider URL
# Leave blank to use the provider's default URL
VITE_BASE_URL=

# LLM model name — overrides the built-in default model for the selected provider
# Example: claude-sonnet-4-6, deepseek-v4-flash
VITE_LLM_MODEL=

# ============================================================
# Vercel Deployment (server-side only, NOT exposed to the browser)
# ============================================================

# Official experience API key — used by /api/official/* before VITE_API_KEY
OFFICIAL_API_KEY=

# Supabase anon key — server-side copy used by /api/sessions/* together with
# the caller's Supabase access token so database RLS policies still apply.
SUPABASE_ANON_KEY=

# Supabase service role key — server-side only. Reserve this for trusted admin
# or maintenance jobs; user-owned CRUD should use SUPABASE_ANON_KEY + user JWT.
# Never expose this in VITE_* vars.
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email for /api/auth-email. Keep both server-only: never use VITE_.
RESEND_API_KEY=
# A verified Resend sender, for example: oddeNova <noreply@oddenove.com>
EMAIL_FROM=

# Required for the /api/cleanup cron job authentication
# Generate with: openssl rand -hex 32
CRON_SECRET=
