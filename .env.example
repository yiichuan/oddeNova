# ============================================================
# oddeNova Environment Variables
# ============================================================
#
# NOTE: API keys can also be configured in the app UI (ApiKeyModal).
# These env vars are OPTIONAL overrides for development and CI scripts.
#
# For eval scripts (scripts/eval/), see scripts/eval/.env.example instead.

# LLM API key — overrides the key stored via the in-app UI
# Anthropic key format: sk-ant-xxxxx
# DeepSeek key format:  sk-xxxxx
VITE_API_KEY=

# LLM API base URL — overrides the built-in provider URL
# Leave blank to use the provider's default URL
VITE_BASE_URL=

# LLM model name — overrides the built-in default model for the selected provider
# Example: claude-sonnet-4-6, deepseek-v4-flash
VITE_LLM_MODEL=

# ============================================================
# Vercel Deployment (server-side only, NOT exposed to the browser)
# ============================================================

# Official experience API key — used by /api/official/* before VITE_API_KEY
OFFICIAL_API_KEY=

# Required for the /api/cleanup cron job authentication
# Generate with: openssl rand -hex 32
CRON_SECRET=
