{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // The build scripts are node programs, not app code: they belong to this
  // project so `Buffer` and `node:*` resolve. Listed one by one rather than as
  // `scripts` — the older scripts in there have never been type-checked.
  "include": [
    "vite.config.ts",
    "scripts/build-animation-previews.ts",
    "scripts/animation-previews/**/*.ts"
  ]
}
