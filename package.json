{
  "name": "odde-nova",
  "private": true,
  "version": "0.1.0",
  "description": "AI-powered music creation tool — describe music in natural language, let the Agent compose layered Strudel patterns and play them instantly in the browser.",
  "keywords": [
    "ai",
    "music",
    "strudel",
    "live-coding",
    "agent",
    "web-audio",
    "anthropic",
    "deepseek",
    "typescript"
  ],
  "homepage": "https://www.oddenova.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yiichuan/oddeNova.git"
  },
  "bugs": {
    "url": "https://github.com/yiichuan/oddeNova/issues"
  },
  "type": "module",
  "scripts": {
    "predev": "npm run fonts:greetings",
    "dev": "vite",
    "prebuild": "npm run fonts:greetings",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "preview": "vite preview",
    "postinstall": "patch-package",
    "prepare": "husky",
    "eval": "node --env-file=scripts/eval/.env --import=tsx/esm scripts/eval/runner.ts",
    "eval:report": "node --env-file=scripts/eval/.env --import=tsx/esm scripts/eval/report.ts",
    "gen:skill-refs": "node --import=tsx/esm scripts/generate-skill-references.ts",
    "fonts:greetings": "node --import=tsx/esm scripts/build-greeting-font-subset.ts",
    "previews:animation": "node --import=tsx/esm scripts/build-animation-previews.ts"
  },
  "dependencies": {
    "@airjelly/sdk": "^0.1.0",
    "@anthropic-ai/sdk": "^0.90.0",
    "@codemirror/language": "6.12.3",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.41.1",
    "@lezer/highlight": "1.2.3",
    "@lezer/javascript": "^1.5.4",
    "@strudel/codemirror": "^1.3.0",
    "@strudel/core": "^1.2.6",
    "@strudel/draw": "^1.2.6",
    "@strudel/mini": "^1.2.6",
    "@strudel/tonal": "^1.2.6",
    "@strudel/transpiler": "^1.2.6",
    "@strudel/webaudio": "^1.3.0",
    "@supabase/supabase-js": "^2.110.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.3.3",
    "@vercel/functions": "^3.7.6",
    "@vercel/speed-insights": "^2.0.0",
    "claviature": "^0.1.0",
    "idb": "^8.0.3",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.23.0",
    "openai": "^6.34.0",
    "posthog-js": "^1.407.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.8.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.4.0",
    "happy-dom": "^20.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "patch-package": "^8.0.1",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "subset-font": "^2.5.0",
    "tailwindcss": "^4.2.2",
    "tsx": "4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^2.1.9"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0"
    ]
  }
}
